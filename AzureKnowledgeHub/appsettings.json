{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:your-server.database.windows.net,1433;Initial Catalog=AzureKnowledgeHubDb;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "JwtSettings": {
    "Issuer": "AzureKnowledgeHub",
    "Audience": "AzureKnowledgeHub.Api",
    "SecretKey": "REPLACE_WITH_A_SECURE_KEY_FROM_USER_SECRETS_OR_AZURE_KEY_VAULT",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
